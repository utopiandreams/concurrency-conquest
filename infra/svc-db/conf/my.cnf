[mysqld]
# --- 문자셋 ---
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
skip-name-resolve

# --- 동시성 실험의 전제 조건 (기본값이지만 명시) ---
# 격리 수준이 바뀌면 Lost Update 재현 결과가 달라진다
transaction-isolation    = REPEATABLE-READ
innodb_lock_wait_timeout = 50
innodb_print_all_deadlocks = ON  # 데드락 발생 시 에러 로그에 전부 남김

# --- 리소스 (VM RAM 5GB 기준) ---
innodb_buffer_pool_size = 3G
max_connections         = 500

# --- 커밋 내구성: 운영과 같은 값 유지 (성능 실험에서 바꾸지 말 것) ---
innodb_flush_log_at_trx_commit = 1
sync_binlog                    = 1

# --- 관측 ---
slow_query_log      = ON
long_query_time     = 0.5
performance_schema  = ON
