# 이 파일을 terraform.tfvars로 복사해서 값을 채운다.
# terraform.tfvars는 .gitignore에 들어 있어 커밋되지 않는다. 토큰은 절대 커밋하지 말 것.

pve_endpoint  = "https://172.30.1.200:8006/"
pve_api_token = "root@pam!terraform=여기에-발급받은-secret"

# 아래는 기본값과 같으면 생략해도 된다
# pve_node            = "proxmox"
# template_vm_id      = 9000
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
